# Neon PostgreSQL ulanish manzili (Neon konsoli yoki Vercel → Storage → Neon).
# Bo'sh qoldirilsa, lokal ishlab chiqishda .pglite/ papkasidagi o'rnatilgan baza ishlatiladi.
DATABASE_URL=

# Birinchi administrator (npm run db:seed paytida yaratiladi)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Ixtiyoriy: parolni e-pochta orqali tiklash uchun Resend API kaliti va jo'natuvchi manzil
RESEND_API_KEY=
MAIL_FROM=
# Sayt manzili (parol tiklash havolalari uchun), masalan https://elektronraqam.uz
APP_URL=http://localhost:3000
CONTACT_EMAIL=
